{
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(deno:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(poetry:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(node:*)",
      "Bash(cargo:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(brew:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(afplay:*)",
      "Bash(osascript:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.secrets)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(**/*credentials*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git branch --show-current 2>/dev/null || echo '-'); changes=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' '); echo \"startup hook success: 🚀 Claude Code session started in:$(pwd)\"",
            "statusMessage": "Starting session"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Session ended\" with title \"Claude Code\"' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_FILE_PATH\"; if [[ \"$file\" == *.js || \"$file\" == *.ts || \"$file\" == *.jsx || \"$file\" == *.tsx ]]; then npx prettier --write \"$file\" 2>/dev/null || true; elif [[ \"$file\" == *.py ]]; then ruff format \"$file\" 2>/dev/null || true; fi",
            "timeout": 10,
            "statusMessage": "Formatting code",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_FILE_PATH\"; if [[ \"$file\" == *.js || \"$file\" == *.ts || \"$file\" == *.jsx || \"$file\" == *.tsx ]]; then npx prettier --write \"$file\" 2>/dev/null || true; elif [[ \"$file\" == *.py ]]; then ruff format \"$file\" 2>/dev/null || true; fi",
            "timeout": 10,
            "statusMessage": "Formatting code",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Review this git commit. Check if sensitive files (.env, credentials, keys) are being committed. If so, respond with 'BLOCK: [reason]'. Otherwise respond 'ALLOW'. Commit info: $ARGUMENTS",
            "model": "claude-haiku-4-5-20251001",
            "statusMessage": "Security check"
          }
        ]
      },
      {
        "matcher": "Bash(rm -rf:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: rm -rf is destructive. Use trash or confirm with user first.'",
            "statusMessage": "Destructive command guard"
          }
        ]
      },
      {
        "matcher": "Bash(rm -r:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: rm -r is destructive. Use trash or confirm with user first.'",
            "statusMessage": "Destructive command guard"
          }
        ]
      },
      {
        "matcher": "Bash(git push --force:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: Force push can destroy remote history. Confirm with user first.'",
            "statusMessage": "Destructive command guard"
          }
        ]
      },
      {
        "matcher": "Bash(git push -f:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: Force push can destroy remote history. Confirm with user first.'",
            "statusMessage": "Destructive command guard"
          }
        ]
      },
      {
        "matcher": "Bash(git reset --hard:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: Hard reset discards uncommitted changes. Confirm with user first.'",
            "statusMessage": "Destructive command guard"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Pop.aiff 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Task completed\" with title \"Claude Code\"' 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "autoMemoryEnabled": true
}
